# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# Optional Admin Bootstrap Passcode (if set, enables login with this passcode for owner email)
ADMIN_BOOTSTRAP_PASSCODE=
ADMIN_BOOTSTRAP_EMAIL=

# Optional Session Signing Secret & Encryption Master Key (auto-generated securely if omitted)
SESSION_SECRET=
ENCRYPTION_MASTER_KEY=

# Optional GitHub Personal Access Token for higher API rate limits during repo sync
GITHUB_TOKEN=

# Optional Groq API Key (can also be configured in AI Studio Secrets as `groq-api`)
GROQ_API_KEY=
